@startuml 04_1_activity
title Сценарий UC2 «Заказ товара»: шаги покупателя и системы

|Покупатель|
start
:(Предусловие) Покупатель авторизован
и просматривает каталог (UC1);

partition "UC2.1 Добавление товара в корзину" {
  :(1) Добавляет товар в корзину;
  |Система|
  if (Товар есть и лимит не превышен?) then (да)
    :Создаёт корзину при необходимости,
    добавляет позицию;
  else (нет)
    :Показывает «Нет в наличии»
    или «Не больше 10 шт.»;
    |Покупатель|
    stop
  endif
  |Покупатель|
  :(2) Переходит в корзину;
}

partition "UC2.2 Действия со списком товаров" {
  :(3) Просматривает позиции, цены, наличие;
  fork
    :(4) Меняет количество;
  fork again
    :(5) Удаляет позицию;
  fork again
    :(6) Отмечает позиции / «Выбрать всё»;
  end fork
}

partition "UC2 Заказ товара" {
  :(7) Проверяет итог по выбранным позициям;
  :(8) Нажимает «Оформить заказ»;
  |Система|
  if (Наличие и цены не изменились?) then (да)
    :Создаёт заказ, резервирует товар,
    убирает позиции из корзины;
  else (нет)
    :Показывает новые цены
    или недоступные позиции;
    |Покупатель|
    stop
  endif
}

|Покупатель|
partition "UC2.3 Ввод и проверка данных" {
  repeat
    |Покупатель|
    :(9) Вводит или исправляет контакты,
    адрес, способ получения;
    |Система|
    :Проверяет формат и зону доставки;
  repeat while (Есть ошибки?) is (да: показать у полей)
  ->нет;
}

|Покупатель|
partition "UC2.4 Оплата заказа" {
  repeat
    |Покупатель|
    :(10) Оплачивает на странице платёжного шлюза;
    |Система|
  repeat while (Оплата не прошла, срок не истёк?) is (да)
  ->нет;
  if (Оплата прошла?) then (да)
    :(11) Показывает подтверждение заказа;
  else (нет: прошло 30 минут)
    :(AF-1) Отменяет заказ, снимает резерв;
    stop
  endif
}

partition "UC2.5 Доставка" {
  :(12) Передаёт заказ в службу доставки;
  |Покупатель|
  :(Завершение) Получает заказ;
}
stop
@enduml
