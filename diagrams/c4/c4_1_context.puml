@startuml c4_1_context
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()

title Уровень 1. Контекст: онлайн-заказ в магазине смартфонов

Person(buyer, "Покупатель", "Выбирает, заказывает и оплачивает смартфоны на сайте или в приложении")
Person(operator, "Оператор магазина", "Разбирает заказы, требующие ручной обработки")
Person(admin, "Администратор", "Управляет ролями, смотрит журнал аудита")

System(shop, "Интернет-магазин: онлайн-заказ", "Корзина, оформление и оплата заказа, передача в доставку, статус заказа")

System_Ext(auth, "Сервис аутентификации", "Существующий сервис компании: вход, токены, роли")
System_Ext(pay, "Платёжный шлюз", "Оплата картой и через СБП")
System_Ext(delivery, "Служба доставки", "Курьерская доставка и пункты выдачи")
System_Ext(erp, "Учётная система", "Источник остатков товара")

Rel(buyer, shop, "Собирает корзину, оформляет и оплачивает заказ", "HTTPS")
Rel(operator, shop, "Ищет заказы, разбирает очередь", "HTTPS")
Rel(admin, shop, "Назначает роли, смотрит аудит", "HTTPS")

Rel(shop, auth, "Проверяет токены и роли")
Rel(shop, pay, "Создаёт платёж", "REST")
Rel_Back(shop, pay, "Сообщает результат оплаты", "webhook")
Rel(shop, delivery, "Создаёт отправление", "REST")
Rel_Back(shop, delivery, "Сообщает статус доставки", "webhook")
Rel(erp, shop, "Передаёт остатки", "синхронизация, вне решения")
Rel(buyer, pay, "Вводит данные карты на странице шлюза", "HTTPS")
@enduml
